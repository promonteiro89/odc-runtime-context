<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>RuntimeContext</AssemblyName>
    <RootNamespace>RuntimeContext</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile-time contract only; ExcludeAssets=runtime keeps the SDK dll out of our build output -->
    <PackageReference Include="OutSystems.ExternalLibraries.SDK" Version="1.5.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="app-icon.png" LogicalName="app-icon.png" />
    <EmbeddedResource Include="action-icon.png" LogicalName="action-icon.png" />
  </ItemGroup>

</Project>
